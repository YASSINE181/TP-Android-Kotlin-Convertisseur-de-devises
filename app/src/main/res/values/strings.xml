<resources>
    <!-- Nom et titre de l'application -->
    <string name="app_name">Currency Converter</string>
    <string name="titre_application">Currency Converter</string>

    <!-- Valeurs par défaut d'affichage -->
    <string name="montant_initial">0</string>
    <string name="resultat_initial"></string>

    <!-- Boutons d'action -->
    <string name="btn_convertir">CONVERTIR</string>
    <string name="btn_inverser_desc">Inverser les devises</string>

    <!-- Messages Toast -->
    <string name="toast_montant_zero">Veuillez saisir un montant</string>

    <!-- Touches du clavier numérique -->
    <string name="key_0">0</string>
    <string name="key_1">1</string>
    <string name="key_2">2</string>
    <string name="key_3">3</string>
    <string name="key_4">4</string>
    <string name="key_5">5</string>
    <string name="key_6">6</string>
    <string name="key_7">7</string>
    <string name="key_8">8</string>
    <string name="key_9">9</string>
    <string name="key_dot">.</string>
    <string name="key_clear">C</string>

    <!-- Tableau des devises supportées -->
    <string-array name="devises">
        <item>USD</item>
        <item>EUR</item>
        <item>TND</item>
        <item>GBP</item>
        <item>JPY</item>
        <item>CAD</item>
    </string-array>
</resources>
